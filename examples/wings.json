        },
        "leds": {
          "rw": {
            "animation": "fill_primary"
          },
          "lw": {
            "animation": "fill_primary"
          }
        }
      },
      "extend dark": {
        "servos": {
          "l": {
            "angle": 90,
            "delay": 0.1
          },
          "r": {
            "angle": 90,
            "delay": 0.1
          }
        },
        "outputs": {
          "wing_power": "high"
        },
        "leds": {
          "rw": {
            "animation": "off"
          },
          "lw": {
            "animation": "off"
          }
        }
      },
      "retract": {
        "servos": {
          "l": {
            "angle": 168
          },
          "r": {
            "angle": 12
          }
        },
        "outputs": {
          "wing_power": {
            "state": "low",
            "delay": 2
          }
        },
        "leds": {
          "rw": {
            "animation": "off"
          },
          "lw": {
            "animation": "off"
          }
        },
        "scripts": []
      }
